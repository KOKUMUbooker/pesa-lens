<?xml version="1.0" encoding="UTF-8" ?>
<uranium:UraniumContentPage
    x:Class="PesaScope.App.Views.Onboarding.PermissionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="clr-namespace:UraniumUI.Pages;assembly=UraniumUI"
    NavigationPage.HasNavigationBar="False"
    xmlns:v="clr-namespace:PesaScope.App.Views.Onboarding"
    x:DataType="v:PermissionPage"
    BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="32,64,32,24" Spacing="0">

                <Border
                    HorizontalOptions="Center"
                    WidthRequest="100" HeightRequest="100"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource PrimaryContainerDark}}"
                    StrokeThickness="0"
                    Margin="0,0,0,32">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Label Text="📩" FontSize="44"
                        HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label
                    Text="Read your M-Pesa messages"
                    FontSize="26" FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light={StaticResource OnBackground}, Dark={StaticResource OnBackgroundDark}}"
                    Margin="0,0,0,12" />

                <Label
                    Text="PesaScope needs SMS permission to import your existing M-Pesa history and automatically capture new transactions."
                    FontSize="15" LineHeight="1.5"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                    Margin="0,0,0,32" />

                <Label Text="WHAT THIS ENABLES"
                    FontSize="11" FontAttributes="Bold" CharacterSpacing="1.2"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    Margin="0,0,0,12" />

                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}"
                    StrokeThickness="0" Margin="0,0,0,32">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Padding="20" Spacing="18">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Grid.Column="0" Text="📥" FontSize="20" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Import your history"
                                    FontSize="14" FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                                <Label Text="We read your existing M-Pesa messages once, to build your transaction history."
                                    FontSize="13" LineHeight="1.4"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1"
                            Color="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                            Opacity="0.5" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Grid.Column="0" Text="⚡" FontSize="20" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Real-time capture"
                                    FontSize="14" FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                                <Label Text="New M-Pesa messages are picked up and categorized the moment they arrive."
                                    FontSize="13" LineHeight="1.4"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource PrimaryContainerDark}}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Grid Padding="16" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="🔒" FontSize="18" VerticalOptions="Start" />
                        <Label Grid.Column="1"
                            Text="PesaScope only reads MPESA messages. Nothing leaves your device."
                            FontSize="13" LineHeight="1.4" LineBreakMode="WordWrap"
                            TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource OnPrimaryContainerDark}}" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="32,12,32,48" Spacing="10">

            <Button
                x:Name="PrimaryButton"
                Text="Grant SMS Permission"
                Clicked="OnPrimaryButtonClicked"
                HorizontalOptions="Fill"
                HeightRequest="52" CornerRadius="14"
                FontSize="16" FontAttributes="Bold"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />

            <Border
                x:Name="DeniedBanner"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource ErrorContainer}, Dark={StaticResource ErrorContainerDark}}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="16" Spacing="6">
                    <Label x:Name="DeniedTitle"
                        Text="Permission denied"
                        FontSize="14" FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                    <Label x:Name="DeniedMessage"
                        Text="PesaScope cannot capture transactions without this. Tap Try Again or go to Settings -> Apps -> PesaScope -> Permissions."
                        FontSize="13" LineHeight="1.4"
                        TextColor="{AppThemeBinding Light={StaticResource OnErrorContainer}, Dark={StaticResource OnErrorContainerDark}}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

    </Grid>

</uranium:UraniumContentPage>